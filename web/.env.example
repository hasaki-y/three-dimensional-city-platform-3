# Omit VITE_API_BASE_URL for same-origin /api/v1 through the Vite proxy.
# Set a Cesium ion token only when you have access to its world terrain service.
VITE_CESIUM_ION_TOKEN=

# Optional Web Mercator XYZ providers. Retain the appropriate provider attribution.
# Defaults: Esri Dark Gray/Light Gray/World Imagery. Online access is required.
VITE_BASEMAP_DARK_URL=
VITE_BASEMAP_LIGHT_URL=
VITE_BASEMAP_IMAGERY_URL=
VITE_BASEMAP_CREDIT=
