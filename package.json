{
  "name": "city-digital-twin",
  "version": "1.0.0",
  "private": true,
  "description": "三维城市数字孪生 WebGIS 平台（教学版）",
  "scripts": {
    "dev": "node scripts/start-dev.cjs",
    "dev:demo": "node scripts/start-dev.cjs --demo",
    "db:init": "node scripts/postgis-local.cjs init",
    "db:start": "node scripts/postgis-local.cjs start",
    "db:stop": "node scripts/postgis-local.cjs stop",
    "db:status": "node scripts/postgis-local.cjs status",
    "db:import:local": "node --env-file=.env.postgis.local server/scripts/import-postgis.js",
    "db:verify": "node --env-file=.env.postgis.local server/scripts/verify-postgis.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "concurrently": "^9.1.0"
  }
}
